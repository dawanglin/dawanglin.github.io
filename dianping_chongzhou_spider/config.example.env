# 基础配置
DB_PATH=./data/chongzhou_shops.db
OUTPUT_CSV=./data/chongzhou_shops.csv

# 请求配置
REQUEST_TIMEOUT=15
MIN_SLEEP_SECONDS=1.0
MAX_SLEEP_SECONDS=2.2

# 可按需替换为你的 cookie（部分页面需要登录态）
DIANPING_COOKIE=

# 渠道入口（建议先从少量页面测试）
CHANNEL_URLS=https://www.dianping.com/chengdu/ch10/g110;https://www.dianping.com/chengdu/ch30/g141

# 每个频道最多抓取页数（MVP 建议 1~3）
MAX_PAGES_PER_CHANNEL=2
